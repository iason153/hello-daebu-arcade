{
  "crons": [
    {
      "path": "/api/cleanup-cards",
      "schedule": "0 18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/c/:wid",
      "destination": "/api/wallet?share=:wid"
    },
    {
      "source": "/d/:id",
      "destination": "/api/duel?share=:id"
    },
    {
      "source": "/k/:id",
      "destination": "/api/castle?share=:id"
    },
    {
      "source": "/sea/api",
      "destination": "/api/sea"
    },
    {
      "source": "/sea/room",
      "destination": "/api/sea-room"
    }
  ],
  "headers": [
    {
      "source": "/sea/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/sea/"
        }
      ]
    }
  ]
}